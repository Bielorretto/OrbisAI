# Clé API Mistral (https://console.mistral.ai). Ne jamais committer le fichier .env.
MISTRAL_API_KEY=

# auto : essaie Mistral, bascule en mode simulé si l'API échoue
# mock : toujours simulé (tests, démo hors ligne)
# live : Mistral uniquement (erreur si l'API échoue)
AI_MODE=auto

# Modèles : vérifier qu'ils sont inclus dans votre abonnement Mistral (sinon erreur 403 ou 429).
# Avec l'offre gratuite, les « ministral » fonctionnent ; avec une offre payante, mistral-large-latest est meilleur.
MISTRAL_MODEL_LARGE=ministral-14b-latest
MISTRAL_MODEL_SMALL=ministral-8b-latest
MISTRAL_MODEL_CHAT=ministral-14b-latest
MISTRAL_EMBED_MODEL=mistral-embed

DATABASE_URL=sqlite:///data/loickaton.db
